# ============================================================================
# Nexora Production Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in real values before running docker compose.
# NEVER commit .env to git — it is gitignored.

# ----- Ports -----
FRONTEND_PORT=80
GATEWAY_PORT=8080
DISCOVERY_PORT=8761
CONFIG_PORT=8888
USER_SERVICE_PORT=9020
POSTS_SERVICE_PORT=9010
CONNECTION_SERVICE_PORT=8090
NOTIFICATION_SERVICE_PORT=9030
CHAT_SERVICE_PORT=9040
ZIPKIN_PORT=9411
KAFKA_PORT=9092
REDIS_PORT=6379

# ----- JWT -----
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_256_BIT_BASE64_SECRET
JWT_ACCESS_TOKEN_EXPIRATION=1800000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ----- AWS S3 / CloudFront -----
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=nexora-media-mumbai
AWS_CLOUDFRONT_DOMAIN=https://your-cloudfront-domain.cloudfront.net

# ----- Email (SMTP) -----
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=CHANGE_ME

# ----- User Service Database -----
USER_DB_URL=jdbc:postgresql://your-host/your-db?sslmode=require
USER_DB_USERNAME=CHANGE_ME
USER_DB_PASSWORD=CHANGE_ME

# ----- Posts Service Database -----
POSTS_DB_URL=jdbc:postgresql://your-host/your-db?sslmode=require
POSTS_DB_USERNAME=CHANGE_ME
POSTS_DB_PASSWORD=CHANGE_ME

# ----- Notification Service Database -----
NOTIF_DB_URL=jdbc:postgresql://your-host/your-db?sslmode=require
NOTIF_DB_USERNAME=CHANGE_ME
NOTIF_DB_PASSWORD=CHANGE_ME

# ----- Chat Service Database -----
CHAT_DB_URL=jdbc:postgresql://your-host/your-db?sslmode=require
CHAT_DB_USERNAME=CHANGE_ME
CHAT_DB_PASSWORD=CHANGE_ME

# ----- Neo4j (Connection Service) -----
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME
NEO4J_DATABASE=neo4j
